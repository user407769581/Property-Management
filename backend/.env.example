NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-your-own-secret
DATABASE_URL=mysql://user:password@127.0.0.1:3306/property_service
WECHAT_APP_ID=replace-with-mini-program-app-id
WECHAT_APP_SECRET=replace-with-mini-program-app-secret
OSS_ACCESS_KEY_ID=replace-with-your-oss-key
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-secret
OSS_BUCKET=replace-with-oss-bucket
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=oss-accelerate.aliyuncs.com
OSS_BUCKET_DOMAIN=https://replace-with-oss-bucket.oss-accelerate.aliyuncs.com
ADMIN_API_BASE_URL=https://api.example.com
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MOCK_MODE=true
WECHAT_PAY_APP_ID=replace-with-customer-mini-program-app-id
WECHAT_PAY_MCH_ID=replace-with-wechat-pay-mch-id
WECHAT_PAY_API_V3_KEY=replace-with-api-v3-key
WECHAT_PAY_MCH_SERIAL_NO=replace-with-mch-serial-no
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=./certs/wechatpay_platform.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/pay/wechat/notify
