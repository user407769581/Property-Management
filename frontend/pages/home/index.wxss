.srv-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:4px 0}
.srv-card{border-radius:12px;padding:20px 16px;display:flex;align-items:center;position:relative;overflow:hidden;cursor:pointer;transition:.15s;min-height:86px}
.srv-card:active{transform:scale(.97)}
.srv-card .srv-info{position:relative;z-index:2}
.srv-t{font-size:18px;font-weight:600;margin-bottom:4px;color:var(--bk)}
.srv-sub{font-size:13px;color:var(--g5)}
/* 与 index.html .srv-ic svg 一致：单色图标用 CSS mask，须写在 WXSS（WXML 内联 style 的 url({{}}) 在小程序中常失效） */
.srv-ic {
  position: absolute;
  right: -4px;
  bottom: -8px;
  width: 48px;
  height: 48px;
  opacity: 0.2;
  transform: rotate(-10deg);
  -webkit-mask-size: cover;
  mask-size: cover;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}
