.rent{background:#fff;border-radius:var(--R);overflow:hidden;margin:0 20px 12px;box-shadow:var(--sh);transition:.15s}
.rent:active{transform:scale(.98)}
.rent-img{height:155px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.rent-cover{position:absolute;left:0;top:0;width:100%;height:100%;z-index:0}
.rent-icon,.rent-pr{position:relative;z-index:1}
.rent-pr{position:absolute;bottom:10px;left:10px;background:rgba(26,26,26,.85);color:var(--gold);padding:4px 12px;border-radius:16px;font-size:13px;font-weight:600;backdrop-filter:blur(8px)}
.rent-icon {
  width: 32px;
  height: 32px;
  background-color: var(--g3);
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='32' height='32' viewBox='0 0 24 24' stroke='black' stroke-width='1' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='3' y='3' width='18' height='18' rx='2'/%3E%3Ccircle cx='8.5' cy='8.5' r='1.5'/%3E%3Cpolyline points='21 15 16 10 5 21'/%3E%3C/svg%3E");
  -webkit-mask-size: cover;
}