<view class="page-sub">
  <view style="background:#fff">
    <view class="ann" wx:for="{{announcements}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view style="font-size:10px;color:var(--gold);font-weight:500;letter-spacing:.5px;margin-bottom:3px">{{item.date}}</view>
      <view style="font-size:14px;font-weight:600;margin-bottom:3px">{{item.title}}</view>
      <view style="font-size:12px;color:var(--g5);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{{item.desc}}</view>
    </view>
  </view>
</view>