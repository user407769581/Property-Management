.fbar{display:flex;gap:7px;padding:8px 20px;white-space:nowrap;}
.ft{display:inline-block;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;color:var(--g5);background:#fff;cursor:pointer;border:1px solid var(--g2);transition:.2s;-webkit-tap-highlight-color:transparent}
.ft.on{background:var(--gold);color:#fff;border-color:var(--gold)}

