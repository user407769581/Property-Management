.paid-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--g1);
}
.paid-row:last-child {
  border-bottom: none;
}
.paid-month {
  font-size: 14px;
  font-weight: 600;
  color: var(--bk);
}
.paid-title {
  font-size: 12px;
  color: var(--g5);
  margin-top: 4px;
}
.paid-time {
  font-size: 11px;
  color: var(--g3);
  margin-top: 6px;
}
.paid-amount-wrap {
  text-align: right;
  flex-shrink: 0;
}
.paid-amount {
  font-size: 16px;
  font-weight: 600;
  color: var(--bk);
}
.paid-tag {
  font-size: 11px;
  color: var(--grn);
  margin-top: 4px;
  font-weight: 500;
}
.paid-empty {
  margin-top: 4px;
}
