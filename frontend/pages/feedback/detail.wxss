.tli {
  display: flex;
  gap: 11px;
  padding-bottom: 18px;
  position: relative;
}
.tli::before {
  content: '';
  position: absolute;
  left: 13px;
  top: 28px;
  bottom: 0;
  width: 1.5px;
  background: var(--g2);
}
.tli:last-child::before {
  display: none;
}
.tld {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}
.tld.off {
  background: var(--g2);
}
.icon-chk {
  width: 12px;
  height: 12px;
  background-color: #fff;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='black' stroke-width='2.5' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolyline points='20 6 9 17 4 12'/%3E%3C/svg%3E");
  -webkit-mask-size: cover;
}
