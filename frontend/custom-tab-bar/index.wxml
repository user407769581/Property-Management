<view class="tab-bar">
  <view class="tab-bar-item" wx:for="{{list}}" wx:key="index" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <view class="icon" style="-webkit-mask-image: url(\"{{item.iconPath}}\"); background-color: {{selected === index ? selectedColor : color}}"></view>
    <view class="text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
  </view>
</view>